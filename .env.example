# Copy to .env and enter a NEW key locally. Never paste keys into chat or source code.
# .env is ignored by Git and is read only by the Node server.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OpenAI mode sends de-identified skill/context evidence to the OpenAI API.
# Use AI_PROVIDER=ollama with OLLAMA_MODEL for local-only inference.
# OLLAMA_MODEL=your-installed-model
# OLLAMA_URL=http://127.0.0.1:11434
# EMPLOYEE_ID=E0028
